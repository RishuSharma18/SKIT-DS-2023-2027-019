# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/cctv_parking

# Redis Cache URL (sub-millisecond watchlist lookup & event idempotency)
REDIS_URL=redis://localhost:6379/0

# Maximum parking duration before overstay alert (in minutes)
MAX_ALLOWED_DURATION=240

# Ingestion API Key (x-api-key)
AI_API_KEY=dev-key

# Local AI service URL (OCR upload proxy)
AI_SERVICE_URL=http://127.0.0.1:8001

# Service Port
PORT=5000
