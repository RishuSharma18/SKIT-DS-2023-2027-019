BACKEND_URL=http://localhost:5000
AI_API_KEY=dev-key
CAMERA_ID=cam-1
# Optional comma-separated CAMERA_ID=RTSP_URL entries for concurrent cameras.
RTSP_URLS=
# Path to a video file or a webcam index; used when RTSP_URLS is empty.
VIDEO_SOURCE=samples/parking.mp4
YOLO_MODEL=yolov8n.pt
YOLO_IMAGE_SIZE=1280
TILE_OVERLAP=0.10
TILE_MIN_WIDTH=1920
TILE_MIN_HEIGHT=1200
TILE_NMS_IOU=0.65
CONFIDENCE_THRESHOLD=0.25
FRAME_SKIP=0
TRACKER=bytetrack.yaml
CUSTOM_CLASS_MAP=
# OCR runs on tracked vehicle crops unless a plate detector weight is configured.
PLATE_MODEL=
EASYOCR_MODEL_DIR=models/easyocr
OCR_CONFIDENCE_THRESHOLD=0.60
OCR_VOTE_FRAMES=5
WRONG_PARKING_SECONDS=15
EVENT_SNAPSHOT_DIR=media/alerts
# 1 = read number plates (slow, needs EasyOCR), 0 = detection only
ENABLE_OCR=1
OCR_EVERY_N_FRAMES=10
EXIT_AFTER_MISSING_FRAMES=45
ENTRY_CONFIRM_FRAMES=15
STATIONARY_SECONDS=3
STATIONARY_MIN_MOVEMENT=5
