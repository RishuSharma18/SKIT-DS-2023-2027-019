BACKEND_URL=http://localhost:5000
AI_API_KEY=dev-key
CAMERA_ID=cam-1
# Path to a video file, or 0 for webcam, or an rtsp:// URL
VIDEO_SOURCE=samples/parking.mp4
YOLO_MODEL=yolov8n.pt
YOLO_IMAGE_SIZE=1280
TILE_OVERLAP=0.10
TILE_MIN_WIDTH=1920
TILE_MIN_HEIGHT=1200
TILE_NMS_IOU=0.65
SLOTS_FILE=config/slots.json
CONFIDENCE=0.25
# 1 = read number plates (slow, needs EasyOCR), 0 = detection only
ENABLE_OCR=1
OCR_EVERY_N_FRAMES=10
EXIT_AFTER_MISSING_FRAMES=45
ENTRY_CONFIRM_FRAMES=15
STATIONARY_SECONDS=3
STATIONARY_MIN_MOVEMENT=5
